{
  "name": "onami",
  "private": true,
  "version": "0.1.0",
  "productName": "oNami",
  "description": "oNami",
  "author": "oNami",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && npm run build:electron && vite build",
    "build:renderer": "tsc -b tsconfig.app.json && vite build",
    "build:electron": "tsup",
    "android:sync-assets": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force android/app/src/main/assets/public | Out-Null; Copy-Item -Recurse -Force dist/* android/app/src/main/assets/public\"",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -InstallDependencies -Publish",
    "windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "windows:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Publish",
    "host": "node host/server.js",
    "host:pm2": "pm2 start host/ecosystem.config.cjs --only onami-host --update-env",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "npm rebuild better-sqlite3",
    "build:win": "npm run build && npm run rebuild:electron && electron-builder --win --x64 && npm run rebuild:native",
    "build:mac": "npm run build && npm run rebuild:electron && electron-builder --mac && npm run rebuild:native",
    "dist": "npm run build && npm run rebuild:electron && electron-builder && npm run rebuild:native",
    "release": "npm run build && npm run rebuild:electron && electron-builder --publish always && npm run rebuild:native",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.4.1",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.9.0",
    "mime-types": "^3.0.2",
    "openai": "^6.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@eslint/js": "^9.13.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "tsup": "^8.5.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "app.onami.flashcards",
    "productName": "oNami",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "oNami",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "oNami",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
