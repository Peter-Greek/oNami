generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SyncGroup {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices      Device[]
  events       SyncEvent[]
  cursors      DeviceCursor[]
  mediaObjects MediaObject[]
  snapshot     SyncSnapshot?

  @@map("sync_groups")
}

model Device {
  id          String    @id @db.Uuid
  syncGroupId String?   @map("sync_group_id") @db.Uuid
  name        String
  platform    String
  publicKey   String    @map("public_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")

  syncGroup SyncGroup? @relation(fields: [syncGroupId], references: [id], onDelete: SetNull)

  initiatedPairings PairingSession[] @relation("InitiatorPairings")
  joinedPairings    PairingSession[] @relation("JoiningPairings")
  sourceEvents      SyncEvent[]
  cursors           DeviceCursor[]
  tokens            DeviceToken[]

  @@index([syncGroupId])
  @@map("devices")
}

model PairingSession {
  id                  String    @id @default(uuid()) @db.Uuid
  initiatorDeviceId   String    @map("initiator_device_id") @db.Uuid
  joiningDeviceId     String?   @map("joining_device_id") @db.Uuid
  codeHash            String    @unique @map("code_hash")
  confirmationCode    String    @map("confirmation_code")
  mode                String?
  initiatorConfirmedAt DateTime? @map("initiator_confirmed_at")
  joinerConfirmedAt   DateTime? @map("joiner_confirmed_at")
  completedAt         DateTime? @map("completed_at")
  expiresAt           DateTime  @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  initiator Device  @relation("InitiatorPairings", fields: [initiatorDeviceId], references: [id], onDelete: Cascade)
  joiner    Device? @relation("JoiningPairings", fields: [joiningDeviceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("pairing_sessions")
}

model SyncEvent {
  id             Int      @id @default(autoincrement())
  eventId        String   @unique @map("event_id") @db.Uuid
  syncGroupId    String   @map("sync_group_id") @db.Uuid
  sourceDeviceId String   @map("source_device_id") @db.Uuid
  sequence       Int
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  eventType      String   @map("event_type")
  payloadJson    Json     @map("payload_json")
  createdAt      DateTime @map("created_at")

  syncGroup    SyncGroup @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)
  sourceDevice Device    @relation(fields: [sourceDeviceId], references: [id], onDelete: Cascade)

  @@unique([sourceDeviceId, sequence])
  @@index([syncGroupId, id])
  @@map("sync_events")
}

model DeviceCursor {
  syncGroupId String   @map("sync_group_id") @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  lastEventId Int      @map("last_event_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  syncGroup SyncGroup @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([syncGroupId, deviceId])
  @@map("device_cursors")
}

model MediaObject {
  id          String   @id @default(uuid()) @db.Uuid
  syncGroupId String   @map("sync_group_id") @db.Uuid
  sha256      String
  byteSize    Int      @map("byte_size")
  mimeType    String   @map("mime_type")
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")

  syncGroup SyncGroup @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)

  @@unique([syncGroupId, sha256])
  @@map("media_objects")
}

/// One-time full-data bundle uploaded by a source device to hydrate a freshly
/// paired device. One pending snapshot per sync group; deleted (with its media)
/// once a non-source device acknowledges receipt.
model SyncSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  syncGroupId    String   @unique @map("sync_group_id") @db.Uuid
  sourceDeviceId String   @map("source_device_id") @db.Uuid
  payloadJson    Json     @map("payload_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  syncGroup SyncGroup @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)

  @@map("sync_snapshots")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("device_tokens")
}

model GlobalDeck {
  id           String            @id @default(uuid()) @db.Uuid
  publisherId  String            @map("publisher_id")
  sourceDeckId String            @map("source_deck_id")
  name         String
  cardsJson    Json              @map("cards_json")
  cardCount    Int               @map("card_count")
  publishedAt  DateTime          @default(now()) @map("published_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  hearts       GlobalDeckHeart[]
  media        GlobalDeckMedia[]

  @@unique([publisherId, sourceDeckId])
  @@index([name])
  @@map("global_decks")
}

model GlobalDeckMedia {
  deckId        String     @map("deck_id") @db.Uuid
  sourceMediaId String     @map("source_media_id")
  sha256        String
  mimeType      String     @map("mime_type")
  byteSize      Int        @map("byte_size")
  originalName  String     @map("original_name")
  deck          GlobalDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, sourceMediaId])
  @@index([sha256])
  @@map("global_deck_media")
}

model GlobalDeckHeart {
  deckId        String   @map("deck_id") @db.Uuid
  installationId String  @map("installation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  deck          GlobalDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, installationId])
  @@index([installationId])
  @@map("global_deck_hearts")
}
